<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.b1051c.einkctl">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- package visibility (Android 11+): every launchable app, for per-app profiles and the icon check -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- home screens too (Launcher3 QuickStep has no LAUNCHER activity): the "Home screen" profile and the full
             refresh on returning home (Profiles.homePackages) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- the E-Ink SystemUI plugin: its component state is checked and restored (KeeperService.checkPlugin) -->
        <package android:name="org.b1051c.einkui" />
        <!-- Lock & Sleep: the settings screen offers to open it (SleepRelay sends it explicit broadcasts) -->
        <package android:name="org.b1051c.sleep" />
        <!-- InKognito Setup: the optional parts it offers to remove (KOReader and Lawnchair are also visible through the
             intents above, the icon pack has no launcher activity) and the home screen it switches to -->
        <package android:name="org.koreader.launcher" />
        <package android:name="app.lawnchair" />
        <package android:name="org.b1051c.iconpack" />
        <package android:name="com.android.launcher3" />
    </queries>
    <!-- publish the front-light values for the QS sliders; granted with `pm grant` (development permission) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application android:label="@string/app_name" android:icon="@drawable/ic_eink"
        android:theme="@style/InkTheme" android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- InKognito Setup: first run, started by root (non-exported: root and this app only):
             am start -n org.b1051c.einkctl/.SetupActivity ; later from the settings screen (System) -->
        <activity android:name=".SetupActivity" android:exported="false" android:label="@string/setup_title"
            android:configChanges="orientation|screenSize|density|keyboardHidden" />

        <service android:name=".KeeperService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Re-applies e-ink display settings and switches the frontlight off while the screen sleeps" />
        </service>

        <!-- maintenance actions for adb (root/shell may target a non-exported receiver explicitly):
             am broadcast -n org.b1051c.einkctl/.ActionReceiver -a org.b1051c.einkctl.WHITE_WALLPAPER
             Dark theme state / re-sync: ... -a org.b1051c.einkctl.THEME_SYNC with the boolean extra dry or force
             (see ActionReceiver.THEME_SYNC) -->
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <!-- KOReader's Bigme patch (full refresh, front light); harmless actions only, see KoBridgeReceiver -->
        <receiver android:name=".KoBridgeReceiver" android:exported="true">
            <intent-filter>
                <action android:name="org.b1051c.einkctl.KO_REFRESH" />
                <action android:name="org.b1051c.einkctl.KO_LIGHT" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- an update kills the foreground keeper and Android does not restart it -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service android:name=".AppProfileService" android:exported="true" android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
        </service>

        <service android:name=".TileRefresh" android:icon="@drawable/ic_tile_mode" android:label="@string/tile_refresh"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".TileClear" android:icon="@drawable/ic_tile_clear" android:label="@string/tile_clear"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- TOGGLEABLE_TILE: TalkBack announces on/off for the true toggles (review 2026-10-21) -->
        <service android:name=".TileLight" android:icon="@drawable/ic_tile_light" android:label="@string/tile_light"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".TileRom" android:icon="@drawable/ic_tile_rom" android:label="@string/tile_rom"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".TileLightPreset" android:label="@string/tile_light_preset" android:icon="@drawable/ic_tile_light"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".TileColour" android:label="@string/tile_colour" android:icon="@drawable/ic_tile_colour"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".TileBoost" android:label="@string/tile_boost" android:icon="@drawable/ic_tile_boost"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".TileText" android:label="@string/tile_text" android:icon="@drawable/ic_tile_text"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".TileGrey" android:label="@string/tile_grey" android:icon="@drawable/ic_tile_grey"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".TileAntiShake" android:label="@string/tile_antishake" android:icon="@drawable/ic_tile_antishake"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".TileColorRestore" android:label="@string/tile_colorrestore" android:icon="@drawable/ic_tile_colorrestore"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".TileCover" android:label="@string/tile_cover" android:icon="@drawable/ic_tile_cover"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".TileTouch" android:label="@string/tile_touch" android:icon="@drawable/ic_tile_touch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
