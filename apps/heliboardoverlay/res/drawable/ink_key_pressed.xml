<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed (and "on" for toggle keys): the same key with a short black bar near its bottom edge. No fill change,
     so the e-ink panel only redraws a thin strip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ink_key_normal" />
    <item android:gravity="bottom|center_horizontal" android:bottom="7dp" android:width="22dp" android:height="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
